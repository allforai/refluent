{
  "name": "refluent",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Learn better English from the prompts you already send to coding agents",
  "keywords": [
    "claude-code",
    "codex",
    "english-learning",
    "cli",
    "macos"
  ],
  "type": "module",
  "bin": {
    "refluent": "bin/refluent"
  },
  "files": [
    "bin",
    "dist",
    "hooks",
    "overlay"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allforai/refluent.git"
  },
  "homepage": "https://github.com/allforai/refluent#readme",
  "bugs": {
    "url": "https://github.com/allforai/refluent/issues"
  }
}
